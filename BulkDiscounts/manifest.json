{

  "description": "Automate Discount Addition",
  "manifest_version": 3,
  "name": "Automate Discount Addition",
  "version": "1.1",
  "homepage_url": "https://github.com/Naraceaus/cPanel-Filters",
  "icons": {
    "256": "icons/icon.png"
  },

  "content_scripts": [
 	{
      "matches": ["*://*/_cpanel*"],
      "include_globs" : [
        "*/_cpanel/order*",
        "*/_cpanel/salesorder*",
        "*/_cpanel#pay*",
        "*/_cpanel"
      ],
      "js": ["cPanel/bulk_discounts.js"]
	}
  ]

}
